#Filter table to samples present in metadata
qiime feature-table filter-samples \
  --i-table table.qza \
  --m-metadata-file sample-metadata.tsv \
  --o-filtered-table table_filtered.qza
 
#Remove eukaryotes
qiime taxa filter-table \
  --i-table table_filtered.qza \
  --i-taxonomy taxonomy.qza \
  --p-exclude Eukaryota,Chloroplast,Mitochondria,Unassigned \
  --o-filtered-table table_filtered_no-euks.qza
 
#Barplot
qiime taxa barplot \
  --i-table table_filtered_no-euks.qza \
  --i-taxonomy taxonomy.qza \
  --m-metadata-file sample-metadata.tsv \
  --o-visualization taxa-barplot_triplicate-clustered_no-euks.qzv
