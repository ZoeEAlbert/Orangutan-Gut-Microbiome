fit <- lm(log10_FB ~ PregnancyDay, data = dat_preg)
summary(fit)

#Exact slope, p, R squared
fit_sum <- summary(fit)

slope <- coef(fit)[2]
p_val <- fit_sum$coefficients["PregnancyDay", "Pr(>|t|)"]
r2 <- fit_sum$r.squared

slope
p_val
r2

