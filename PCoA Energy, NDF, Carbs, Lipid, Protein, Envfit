library(ggplot2)
library(viridis)
library(gridExtra)
library(grid)
library(vegan)

#Clean IDs
clean_ids <- function(x) {
  gsub("\\s+", "", trimws(as.character(x)))
}

#Load PCoA
pcoa <- read.delim(
  "bray_curtis_full_pcoa_export/ordination.txt",
  skip = 9,
  sep = "\t",
  check.names = FALSE
)

colnames(pcoa)[1] <- "SampleID"
pcoa$SampleID <- clean_ids(pcoa$SampleID)

#Remove site constraint rows if present
pcoa <- pcoa[!grepl("Site", pcoa$SampleID), ]

#Load metadata
meta <- read.delim(
  "Orangutan_Microbiome_Energetics_Merged.tsv",
  sep = "\t",
  header = TRUE,
  check.names = FALSE
)

meta$`#SampleID` <- clean_ids(meta$`#SampleID`)
meta$Orangutan <- trimws(meta$Orangutan)

#Merge
df_pcoa <- merge(
  pcoa,
  meta,
  by.x = "SampleID",
  by.y = "#SampleID",
  all.x = TRUE
)

#Create nutrient columns
df_pcoa$NDF <- as.numeric(df_pcoa$`Total grams NDF eaten`)
df_pcoa$Carbs <- as.numeric(df_pcoa$`Total grams Carbo eaten`)
df_pcoa$Lipids <- as.numeric(df_pcoa$`Total grams Lipid eaten`)
df_pcoa$Protein <- as.numeric(df_pcoa$`Total grams Protein eaten Crude`)
df_pcoa$Calories <- as.numeric(df_pcoa$`Ttl Kcal eaten 1.782 no lignin Available Protein`)

#Keep only rows with metadata
df_pcoa <- df_pcoa[!is.na(df_pcoa$Orangutan), ]

#Rename first two axes
colnames(df_pcoa)[2:3] <- c("PC1", "PC2")

#% variation explained
lines <- readLines("bray_curtis_full_pcoa_export/ordination.txt")
prop_line <- grep("Proportion", lines)

props <- scan(
  text = lines[prop_line + 1],
  what = numeric(),
  quiet = TRUE
)

pc1_lab <- paste0("PC1 (", round(props[1] * 100, 1), "%)")
pc2_lab <- paste0("PC2 (", round(props[2] * 100, 1), "%)")

#Plot for nutrient panels
make_pcoa_plot <- function(data, var, panel_label, panel_title, legend_title) {
  plot_df <- data[!is.na(data[[var]]), ]

  ggplot(plot_df, aes(x = PC1, y = PC2, color = .data[[var]])) +
    geom_point(size = 3.5, alpha = 0.9) +
    scale_color_viridis_c(
      option = "plasma",
      name = legend_title,
      guide = guide_colorbar(
        barheight = unit(2.5, "cm"),
        barwidth = unit(0.4, "cm"),
        title.position = "top",
        title.hjust = 0.5
      )
    ) +
    labs(
      title = paste0(panel_label, ". ", panel_title),
      x = pc1_lab,
      y = pc2_lab
    ) +
    theme_classic(base_size = 13) +
    theme(
      plot.title = element_text(face = "bold", hjust = 0.5, size = 11),
      axis.title = element_text(face = "bold", size = 10),
      axis.text = element_text(size = 8),
      legend.title = element_text(face = "bold", size = 8),
      legend.text = element_text(size = 7),
      panel.border = element_rect(color = "black", fill = NA, linewidth = 0.5)
    )
}

#Make nutrient panels
p_energy <- make_pcoa_plot(df_pcoa, "Calories", "A", "Energy", "kcal")
p_ndf    <- make_pcoa_plot(df_pcoa, "NDF", "B", "NDF", "NDF (g)")
p_carbs  <- make_pcoa_plot(df_pcoa, "Carbs", "C", "Carbohydrates", "Carbs (g)")
p_lipids <- make_pcoa_plot(df_pcoa, "Lipids", "D", "Lipids", "Lipids (g)")
p_prot   <- make_pcoa_plot(df_pcoa, "Protein", "E", "Protein", "Protein (g)")

#Envfit using ordination axes
fit <- envfit(
  df_pcoa[, c("PC1", "PC2")] ~ Calories + NDF + Carbs + Lipids + Protein,
  data = df_pcoa,
  permutations = 999
)

scores_df <- as.data.frame(scores(fit, "vectors"))
scores_df$var <- rownames(scores_df)

#Make envfit panel
p_envfit <- ggplot(df_pcoa, aes(x = PC1, y = PC2)) +
  geom_point(size = 2.8, alpha = 0.7, color = "gray30") +
  geom_segment(
    data = scores_df,
    aes(x = 0, y = 0, xend = PC1, yend = PC2),
    arrow = arrow(length = unit(0.18, "cm")),
    color = "red",
    linewidth = 0.7
  ) +
  geom_text(
    data = scores_df,
    aes(x = PC1, y = PC2, label = var),
    color = "red",
    size = 3.2,
    vjust = -0.5
  ) +
  labs(
    title = "F. Envfit",
    x = pc1_lab,
    y = pc2_lab
  ) +
  theme_classic(base_size = 13) +
  theme(
    plot.title = element_text(face = "bold", hjust = 0.5, size = 11),
    axis.title = element_text(face = "bold", size = 10),
    axis.text = element_text(size = 8),
    panel.border = element_rect(color = "black", fill = NA, linewidth = 0.5)
  )

#Arrange all 6 panels
panel_plot <- arrangeGrob(
  grobs = list(
    p_energy, p_ndf, p_carbs,
    p_lipids, p_prot, p_envfit
  ),
  ncol = 3,
  nrow = 2,
  top = textGrob(
    "Bray–Curtis PCoA by Dietary Variables",
    gp = gpar(fontsize = 16, fontface = "bold")
  )
)

#Save final figure
ggsave(
  "PCoA_dietary_variables_with_envfit.png",
  panel_plot,
  width = 15,
  height = 10,
  dpi = 300
)

#Draw in R
grid.newpage()
grid.draw(panel_plot)

#Print envfit statistics
