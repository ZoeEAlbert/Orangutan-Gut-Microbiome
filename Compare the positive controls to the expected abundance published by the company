#In R, calculate relative abundance for my samples
library(tidyverse)

counts <- read_tsv(
  "feature-table-absfreq-level7.tsv",
  comment = "#"
)

#Convert to long format
counts_long <- counts %>%
  pivot_longer(
    cols = -Taxon,
    names_to = "SampleID",
    values_to = "Reads"
  )

#Make sure positive controls are their own excel sheet. Export it and name it positive_controls.csv
pos_meta <- read_csv("positive_controls.csv")
counts_pos <- counts_long %>%
  filter(SampleID %in% pos_meta$SampleID)

#Calculate relative abundance per sample
counts_pos <- counts_pos %>%
  group_by(SampleID) %>%
  mutate(RelAbundance = Reads / sum(Reads) * 100) %>%
  ungroup()

