rm(list = ls())
library(tidyverse)
library(scales)

#Read genus table
genus_table <- read.delim(
  "genus_table.tsv",
  sep = "\t",
  header = TRUE,
  skip = 1,
  check.names = FALSE,
  comment.char = "",
  quote = "",
  fill = TRUE
)

#Rename first column
colnames(genus_table)[1] <- "Taxon"

#Read metadata
meta <- read.delim(
  "AgeSexClass_metadata.txt",
  sep = "\t",
  header = TRUE,
  check.names = FALSE
)

#Rename family label 
meta$Family[meta$Family == "UML06MAY24_family"] <- "Eli_family"
meta$Family[meta$Family == "UML06MAY24"] <- "Eli_family"

#Make subset afterrenaming
meta_sub <- meta %>%
  dplyr::select(`#SampleID`, Orangutan, Family)

#Convert to long format
tax_long <- genus_table %>%
  pivot_longer(
    cols = -Taxon,
    names_to = "SampleID",
    values_to = "Abundance"
  )

#Join metadata
plot_df <- tax_long %>%
  inner_join(
    meta_sub,
    by = c("SampleID" = "#SampleID")
  ) %>%
  filter(!is.na(Family))

cat("Matched samples:", length(unique(plot_df$SampleID)), "\n")
cat("Matched families:\n")
print(sort(unique(plot_df$Family)))

#Extract genus cleanly
plot_df <- plot_df %>%
  mutate(
    Genus = ifelse(grepl("g__", Taxon), sub(".*g__", "", Taxon), NA_character_),
    Genus = ifelse(grepl(";.*", Genus), sub(";.*", "", Genus), Genus),
    Genus = trimws(Genus)
  )

#Remove unwanted categories
plot_df <- plot_df %>%
  filter(
    !is.na(Genus),
    Genus != "",
    !grepl("Mitochondria", Taxon, ignore.case = TRUE),
    !grepl("Eukaryota", Taxon, ignore.case = TRUE),
    !grepl("Chloroplast", Taxon, ignore.case = TRUE),
    !Genus %in% c("uncultured", "metagenome", "Ambiguous_taxa", "Unassigned")
  )

#Keep top 10 genera overall
top_genera <- plot_df %>%
  group_by(Genus) %>%
  summarise(total = sum(Abundance), .groups = "drop") %>%
  arrange(desc(total)) %>%
  slice_head(n = 10) %>%
  pull(Genus)

plot_df <- plot_df %>%
  mutate(Genus = ifelse(Genus %in% top_genera, Genus, "Other"))

#Summarize by family
family_sum <- plot_df %>%
  group_by(Family, Genus) %>%
  summarise(Abundance = sum(Abundance), .groups = "drop")

family_rel <- family_sum %>%
  group_by(Family) %>%
  mutate(RelativeAbundance = Abundance / sum(Abundance)) %>%
  ungroup()

#Order genera
genus_levels <- family_sum %>%
  group_by(Genus) %>%
  summarise(total = sum(Abundance), .groups = "drop") %>%
  arrange(desc(total)) %>%
  pull(Genus)

family_sum$Genus <- factor(family_sum$Genus, levels = rev(genus_levels))
family_rel$Genus <- factor(family_rel$Genus, levels = rev(genus_levels))

#Family order
family_order <- c(
  "Alfred_family",
  "Bibi_family",
  "Dude_family",
  "Eli_family",
  "Kabar_family",
  "Sandra_family",
  "Tari_family",
  "Tunjuk_family"
)

family_sum <- family_sum %>%
  filter(Family %in% family_order) %>%
  mutate(Family = factor(Family, levels = family_order))

family_rel <- family_rel %>%
  filter(Family %in% family_order) %>%
  mutate(Family = factor(Family, levels = family_order))

#Colors
okabe_ito <- c(
  "#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2",
  "#D55E00", "#CC79A7", "#999999", "#000000", "#88CCEE", "#DDCC77"
)

n_genera <- length(unique(family_rel$Genus))
fill_colors <- okabe_ito[seq_len(n_genera)]

#Relative abundance plot
p_rel <- ggplot(
  family_rel,
  aes(x = Family, y = RelativeAbundance, fill = Genus)
) +
  geom_col(width = 0.85) +
  scale_fill_manual(values = fill_colors) +
  scale_y_continuous(labels = label_number(accuracy = 0.01)) +
  theme_classic(base_size = 16) +
  labs(
    x = "Family group",
    y = "Relative abundance",
    fill = "Genus",
    title = "Relative abundance of top 10 genera by family group"
  ) +
  guides(
    fill = guide_legend(
      nrow = 3,
      byrow = TRUE
    )
  ) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1),
    plot.title = element_text(hjust = 0.5, face = "bold"),
    legend.position = "bottom",
    legend.title = element_text(face = "bold", size = 14),
    legend.text = element_text(face = "italic", size = 10),
    legend.key.size = unit(0.5, "cm"),
    legend.spacing.x = unit(0.25, "cm"),
    plot.margin = margin(10, 10, 20, 10)
  )

#Differential abundance plot
p_abs <- ggplot(
  family_sum,
  aes(x = Family, y = Abundance, fill = Genus)
) +
  geom_col(width = 0.85) +
  scale_fill_manual(values = fill_colors) +
  scale_y_log10(labels = label_scientific()) +
  theme_classic(base_size = 16) +
  labs(
    x = "Family group",
    y = "Differential abundance (log10 scale)",
    fill = "Genus",
    title = "Differential abundance of top 10 genera by family group"
  ) +
  guides(
    fill = guide_legend(
      nrow = 3,
      byrow = TRUE
    )
  ) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1),
    plot.title = element_text(hjust = 0.5, face = "bold"),
    legend.position = "bottom",
    legend.title = element_text(face = "bold", size = 14),
    legend.text = element_text(face = "italic", size = 10),
    legend.key.size = unit(0.5, "cm"),
    legend.spacing.x = unit(0.25, "cm"),
    plot.margin = margin(10, 10, 20, 10)
  )

#Save figures
ggsave(
  "family_relative_abundance_top10.png",
  plot = p_rel,
  width = 14,
  height = 9,
  dpi = 300,
  bg = "white"
)

ggsave(
  "family_differential_abundance_top10.png",
  plot = p_abs,
  width = 14,
  height = 9,
  dpi = 300,
  bg = "white"
)

ggsave(
  "family_relative_abundance_top10.pdf",
  plot = p_rel,
  width = 14,
  height = 9,
  bg = "white"
)

ggsave(
  "family_differential_abundance_top10.pdf",
  plot = p_abs,
  width = 14,
  height = 9,
  bg = "white"
)

write.table(
  family_rel,
  file = "family_relative_abundance_top10.tsv",
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

write.table(
  family_sum,
  file = "family_differential_abundance_top10.tsv",
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

cat("Top genera kept:\n")
print(sort(setdiff(unique(family_rel$Genus), "Other")))
cat("DONE\n")
